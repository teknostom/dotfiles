general {
	colors = true
	interval = 5
	color_good = "#a3be8c"
	color_bad = "#bf616a"
	color_degraded = "#ebcb8b"
}

order += "ethernet _first_"
order += "cpu_usage"
order += "memory"
order += "volume master"
order += "tztime local"

ethernet _first_ {
	format_up = "E: %ip (%speed)"
	format_down = "E: down"
}

cpu_usage {
	format = "CPU: %usage"
}

memory {
	format = "RAM: %used/%total"
	threshold_degraded = "1G"
	format_degraded = "MEMORY < %avaliable"
}

tztime local {
        format = "%Y-%m-%d %H:%M:%S"
        hide_if_equals_localtime = false
}

