# ============================================================
# i3 Configuration File
# ============================================================
# See https://i3wm.org/docs/userguide.html for reference

set $mod Mod4

# ============================================================
# Appearance
# ============================================================

gaps inner 10
gaps outer 5
for_window [class="^.*"] border pixel 0

# ============================================================
# Key Bindings - Applications
# ============================================================

# Application launcher
bindsym $mod+d exec rofi -show drun -theme ~/.config/rofi/config.rasi

# Terminal
bindsym $mod+Return exec alacritty

# Lock screen (with pywal background)
exec_always --no-startup-id bash -c 'RESOLUTION=$(xrandr --current | grep "Screen 0" | grep -oP "current \K\d+ x \d+" | tr -d " "); convert "$(< "${HOME}/.cache/wal/wal")" -resize ${RESOLUTION}^ -gravity center -extent ${RESOLUTION} -blur 0x8 -fill black -colorize 70% /tmp/lock_bg.png'
bindsym ctrl+l exec i3lock -i /tmp/lock_bg.png --clock --time-color=ffffffff --date-color=ffffffff

# Display management
bindsym $mod+p exec xrandr --auto

# Package management
bindsym $mod+i exec ~/.local/bin/rofi-pacman.sh
bindsym $mod+y exec ~/.local/bin/rofi-yay.sh

# Browser launcher
bindsym $mod+b exec ~/.config/i3/surf-launcher.sh

# ============================================================
# Workspace Management
# ============================================================

# Move workspaces between monitors
bindsym $mod+Ctrl+Left move workspace to output left
bindsym $mod+Ctrl+Right move workspace to output right

# ============================================================
# Window Rules
# ============================================================

for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
